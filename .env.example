# Copia este archivo como .env y rellena los valores reales para desarrollo local
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY=tu_access_key
R2_SECRET_KEY=tu_secret_key
R2_BUCKET=expense-attachments
R2_ENDPOINT=https://tu_account_id.r2.cloudflarestorage.com

# Obligatorio: el backend no arranca sin él. Generar con: openssl rand -hex 64
JWT_SECRET=genera_un_secreto_aleatorio_largo
# Opcional: lista separada por comas de orígenes CORS permitidos
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
